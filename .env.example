# ==========================================
# INDEX METRIX — Production & Environment Configuration Template
# ==========================================

# 1. Application Environment
# For production: set NODE_ENV=production
# For development: set NODE_ENV=development
NODE_ENV=production
PORT=3000

# Canonical Public HTTPS URL (STRICTLY REQUIRED in production, e.g. https://indexmetrix.com)
APP_BASE_URL=https://indexmetrix.com
NEXT_PUBLIC_APP_URL=https://indexmetrix.com

# Cryptographically Secure Session Secret (min. 32 characters, e.g. openssl rand -base64 32)
APP_SECRET=YOUR_APP_SECRET_MIN_32_CHARS_HERE

# 2. Database Connection (PostgreSQL required in production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME?schema=public"

# 3. Redis / BullMQ (Required for production background discovery and queue workers)
# Format: redis://[:password@]host:port[/db] or rediss:// for TLS
REDIS_URL="redis://YOUR_REDIS_HOST:6379"

# 4. Primary Owner Account (Configured on seed/first run)
OWNER_EMAIL="naina@indexmetrix.com"
OWNER_INITIAL_PASSWORD="YOUR_INITIAL_OWNER_PASSWORD_HERE"

# 5. Security & Token Encryption (AES-256-GCM 64-char hex string / 32 bytes)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="YOUR_64_CHAR_HEX_ENCRYPTION_KEY_HERE"

# 6. Google Search Console & OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET"
GOOGLE_REDIRECT_URI="https://indexmetrix.com/api/google/callback"

# 7. IndexNow Key (Optional: for Bing/Yandex submission on owned verified domains)
INDEXNOW_KEY=""

# 8. Payments Configuration (Keep "sandbox" for test mode)
PAYMENT_PROVIDER="sandbox" # "sandbox" | "stripe" | "razorpay"
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"
RAZORPAY_KEY_ID="rzp_test_YOUR_RAZORPAY_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# 9. Logging
LOG_LEVEL="info" # "debug" | "info" | "warn" | "error"
